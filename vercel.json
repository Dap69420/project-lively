{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/config.js",
      "destination": "/api/index?path=config"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/founders",
      "destination": "/founders.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/workspace",
      "destination": "/workspace.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
